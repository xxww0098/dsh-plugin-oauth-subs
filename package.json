{
  "name": "dsh-plugin-oauth-subs",
  "version": "0.0.56",
  "description": "ChatGPT Codex, xAI Grok, Zhipu GLM, AWS Kiro, and Google Antigravity subscription OAuth for DeepSeek Harness — PKCE / device-code / Google login, local Responses proxy, llm-pi-ai sync.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xxww0098/dsh-plugin-oauth-subs.git"
  },
  "bugs": {
    "url": "https://github.com/xxww0098/dsh-plugin-oauth-subs/issues"
  },
  "homepage": "https://github.com/xxww0098/dsh-plugin-oauth-subs#readme",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/ui/client.js",
    "./analyze-session": "./lib/utils/analyze-session.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "external": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
    "AGENTS.md",
    "README.md",
    "README.zh.md"
  ],
  "scripts": {
    "build": "tsc && tsc -p tsconfig.ui.json",
    "test": "npm run build && node --experimental-strip-types --test 'test/*.test.ts'",
    "analyze": "node --experimental-strip-types scripts/analyze-session.ts"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "oauth",
    "chatgpt",
    "codex",
    "grok",
    "xai",
    "glm",
    "kiro",
    "pkce",
    "antigravity",
    "google"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  }
}
