node_modules
*.log
auth.json
proxy-key
fast-mode.json
# root-level runtime artifact only — the catalog's models.json is tracked
# (src/catalog/models.json → lib/, the loader reads it from the build)
/models.json
.DS_Store
*.tsbuildinfo
.local/

# 本地 dev 构建计数（npm run dev-build）——本机状态，不入库
.dev-build.json

# Agent tooling: portable configs are tracked, local write metadata is not.
.amp/*.amp-write-meta

# pnpm local artifacts — regenerable; this repo builds with npm (package-lock.json).
.pnpm-store/
pnpm-lock.yaml

# design throwaway mocks — not shipped, not committed
/prototypes/
.ui-build/

